import pandas as pd
import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Dropout
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, r2_score
from google.colab import files
import joblib

# --- File Uploads ---
print("Upload RGB values file (spectral_to_rgb_results.xlsx):")
uploaded_rgb = files.upload()
rgb_filename = list(uploaded_rgb.keys())[0]
rgb_data = pd.read_excel(rgb_filename, index_col=0)

# --- Feature Engineering ---
rgb_data['Brightness'] = rgb_data[['R', 'G', 'B']].mean(axis=1)
rgb_data['R_G_ratio'] = rgb_data['R'] / (rgb_data['G'] + 1e-5)
rgb_data['G_B_ratio'] = rgb_data['G'] / (rgb_data['B'] + 1e-5)
rgb_data['Saturation'] = (rgb_data[['R', 'G', 'B']].max(axis=1) - rgb_data[['R', 'G', 'B']].min(axis=1)) / \
                         (rgb_data[['R', 'G', 'B']].max(axis=1) + 1e-5)

print("Upload original spectral data file (modified_stepsize.xlsx):")
uploaded_spectral = files.upload()
spectral_filename = list(uploaded_spectral.keys())[0]
spectral_data = pd.read_excel(spectral_filename, index_col=0).T
wavelengths = spectral_data.columns.astype(float)

# Filter wavelengths
valid_indices = (wavelengths >= 300) & (wavelengths <= 800)
wavelengths = wavelengths[valid_indices]
spectral_data = spectral_data.loc[:, valid_indices]

# Align both datasets
spectral_data = spectral_data.loc[rgb_data.index]

# --- Prepare Data ---
X = rgb_data.values
Y = spectral_data.values

# --- Scaling ---
scaler_X = MinMaxScaler()
X_scaled = scaler_X.fit_transform(X)
joblib.dump(scaler_X, 'scaler_X.pkl')

scaler_Y = MinMaxScaler()
Y_scaled = scaler_Y.fit_transform(Y)
joblib.dump(scaler_Y, 'scaler_Y.pkl')

# --- Train/Test Split ---
X_train, X_temp, Y_train, Y_temp = train_test_split(X_scaled, Y_scaled, test_size=0.4, random_state=42)
X_val, X_test, Y_val, Y_test = train_test_split(X_temp, Y_temp, test_size=0.5, random_state=42)

# --- Custom Loss Function ---
importance_weights = np.where((wavelengths >= 400) & (wavelengths <= 700), 2.0, 1.0)
importance_weights = tf.constant(importance_weights, dtype=tf.float32)

def weighted_mse(y_true, y_pred):
    return tf.reduce_mean(tf.multiply(tf.square(y_true - y_pred), importance_weights))

# --- Model Definition ---
model = Sequential([
    Dense(256, activation='relu', input_shape=(X_train.shape[1],)),
    Dropout(0.3),
    Dense(512, activation='relu'),
    Dropout(0.3),
    Dense(512, activation='relu'),
    Dense(Y.shape[1], activation='linear')
])

model.compile(optimizer='adam', loss=weighted_mse, metrics=['mae'])
model.summary()

# --- Callbacks ---
early_stop = tf.keras.callbacks.EarlyStopping(patience=20, restore_best_weights=True)
reduce_lr = tf.keras.callbacks.ReduceLROnPlateau(patience=10, factor=0.5, verbose=1)

# --- Model Training ---
history = model.fit(X_train, Y_train, epochs=300, batch_size=32, validation_data=(X_val, Y_val),
                    callbacks=[early_stop, reduce_lr])

# --- Evaluation ---
loss, mae = model.evaluate(X_test, Y_test)
print(f'Test Loss: {loss}, Test MAE: {mae}')

# --- Predictions ---
predictions_scaled = model.predict(X_test)
predictions = scaler_Y.inverse_transform(predictions_scaled)
Y_test_original = scaler_Y.inverse_transform(Y_test)

mse = mean_squared_error(Y_test_original, predictions)
r2 = r2_score(Y_test_original, predictions)
print(f'Test MSE: {mse}, Test R^2: {r2}')

# --- Windowed Evaluation ---
window_size = 50
window_mse_r2 = []

for start in range(300, 801 - window_size):
    end = start + window_size
    mask = (wavelengths >= start) & (wavelengths < end)
    if np.any(mask):
        mse_window = mean_squared_error(Y_test_original[:, mask], predictions[:, mask])
        r2_window = r2_score(Y_test_original[:, mask], predictions[:, mask])
        window_mse_r2.append((start, end, mse_window, r2_window))
        print(f'Window {start}-{end} nm: MSE = {mse_window:.5f}, R^2 = {r2_window:.5f}')

# --- Save Model & Scalers ---
model_filename = 'rgb_to_spectral_model.keras'
model.save(model_filename)
print(f"Model saved as {model_filename}")

files.download(model_filename)
files.download('scaler_X.pkl')
files.download('scaler_Y.pkl')

# --- Plotting ---
for i in range(len(X_test)):
    plt.figure(figsize=(10, 5))
    plt.plot(wavelengths, Y_test_original[i], label='Actual', marker='o')
    plt.plot(wavelengths, predictions[i], label='Predicted', marker='x')
    plt.title(f'Sample {i+1}: Predicted vs Actual Spectral Intensity')
    plt.xlabel('Wavelength (nm)')
    plt.ylabel('Intensity')
    plt.legend()
    plt.show()

# --- Save Predictions ---
predicted_df = pd.DataFrame(predictions, columns=wavelengths)
predicted_df.index = rgb_data.index[-X_test.shape[0]:]
predicted_df_transposed = predicted_df.T

predicted_filename = 'predicted_spectra.xlsx'
predicted_df_transposed.to_excel(predicted_filename)
print(f"Full predicted spectra saved as {predicted_filename}")

files.download(predicted_filename)
